{
  "name": "@winetoken/dsh-plugin-winetoken",
  "version": "2.1.8",
  "description": "WineToken 全平台推理模型自动同步、双账轨资产监控与现代化 AI 漫剧画布创作工坊。",
  "author": "AyzRuoshui",
  "license": "MIT",
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "import": "./src/index.mjs",
      "require": "./src/index.js"
    },
    "./client": "./src/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "locale/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "sync": "node src/sync.js",
    "test": "node --test tests/**/*.test.js",
    "release": "node scripts/release.cjs"
  },
  "dependencies": {
    "yaml": "^2.4.0"
  }
}
